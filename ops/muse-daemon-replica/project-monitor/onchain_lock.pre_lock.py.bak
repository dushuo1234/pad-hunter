#!/usr/bin/env python3
"""Pad Hunter on-chain lock daemon — match new token contracts to watched projects in seconds.

Polls new blocks (~1–3s) on chains that have public RPCs in factories.json.
For each new contract creation (tx.to is null) and each factory PairCreated/PoolCreated:

  (a) deployer / tx.from in wallet_watchlist.json  -> high (or confirmed if name also matches)
  (b) ERC20 name()/symbol() fuzzy-matches token_name_watchlist.json -> medium
      (ambiguous symbols alone stay low)
  (c) both wallet + name/symbol -> confirmed

Appends matches to onchain_lock_alerts.jsonl and optionally rebuilds ca_finds.json.
State in onchain_lock_state.json (last block per chain).

No API keys. Rotates public RPCs with backoff on rate limits.
"""
from __future__ import annotations

import argparse
import threading
import json
import os
import re
import subprocess
import sys
import time
import traceback
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

