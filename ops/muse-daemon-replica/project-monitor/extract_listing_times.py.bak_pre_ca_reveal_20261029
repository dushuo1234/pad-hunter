#!/usr/bin/env python3
"""
Extract structured launch/listing datetimes for Pad Hunter projects.

Sources (prefer cache, light site re-fetch only when missing):
  - watchlist listing/status fields
  - listing_scan_latest.json signal snippets
  - x_posts_cache.json bios + posts
  - x_listing_posts_cache.json (recent keyword search)
  - TG projects.jsonl summary_cn / summary_en / raw_text
  - optional official site homepage (reuse scan_listing_ca fetch style)

Sticky / fill-forward rules (user Ori):
  - Parseable time → write/update listing_at (+ source/raw/confidence).
  - Not found this run → listing_at stays null; listing_at_display = 「未知」.
  - Once a real listing_at exists, NEVER wipe it on a later empty scan.
  - Only refine when new evidence is clearly better (higher confidence, or
    same-day more precise clock).
  - Exception: AMA/Space/直播 evidence is NOT a listing — reject before add_cand
    and clear sticky false positives (note=rejected:ama_space; raw kept for audit).

Outputs:
  - listing_times.json (+ mirror under push-radar/data/)
  - merges listing_at* into watchlist.json and candidates.json
"""
from __future__ import annotations

import json
import re
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any
from zoneinfo import ZoneInfo

BASE = Path("/workspace/project-monitor")
WATCHLIST = BASE / "watchlist.json"
LISTING_SCAN = BASE / "listing_scan_latest.json"
X_CACHE = BASE / "x_posts_cache.json"
X_LISTING = BASE / "x_listing_posts_cache.json"
TG_JSONL = Path("/home/box/.tg-monitor/projects.jsonl")
TG_PROJECTS = Path("/home/box/.tg-monitor/projects.json")
OUT = BASE / "listing_times.json"
OUT_MIRROR = Path("/workspace/push-radar/data/listing_times.json")
CANDIDATES = Path("/workspace/push-radar/data/candidates.json")

TZ = ZoneInfo("Asia/Shanghai")
UA = "Mozilla/5.0 (compatible; PadHunterListingScan/1.0)"
CONF_RANK = {"high": 3, "medium": 2, "low": 1}

MONTH_EN = {
    "jan": 1, "january": 1, "feb": 2, "february": 2, "mar": 3, "march": 3,
    "apr": 4, "april": 4, "may": 5, "jun": 6, "june": 6, "jul": 7, "july": 7,
    "aug": 8, "august": 8, "sep": 9, "sept": 9, "september": 9,
    "oct": 10, "october": 10, "nov": 11, "november": 11, "dec": 12, "december": 12,
}

VAGUE_ONLY = re.compile(
    r"^(即将开盘|马上开盘|soon|coming\s+soon|this\s+week|launching\s+this\s+week|"
    r"mainnet\s+soon|mint\s+soon|stand\s+by|tba|tbd|不明|未开盘)$",
    re.I,
)

ALREADY_LISTED_RE = re.compile(
    r"(已开盘|开始交易|trading\s+now|trading\s+live|"
    r"token\s+(is\s+)?live|\$\w+\s+goes\s+live|"
    r"\$\w+\s+is\s+officially\s+LIVE)",
    re.I,
)
# Mint-live is NFT minting, not token 开盘 — tracked separately, does not flip listing card
MINT_LIVE_RE = re.compile(
    r"(mint\s+is\s+live|minting\s+now|public\s+mint\s+is\s+live|live\s+now)",
    re.I,
)

LAUNCH_CONTEXT = re.compile(
    r"(开盘|开铸|开售|发射|上线|上市|TGE|launch|launches|launching|mint\s*date|"
    r"mint\s+live|public\s+launch|token\s+live|goes?\s+live|opens?|"
    r"set\s+sail|countdown|铸造|open\s+hiring|second\s+shift|first\s+shift|"
    r"early\s+access|mainnet)",
    re.I,
)

# AMA / Twitter Space / 直播 — never treat as listing/开盘 time
NON_LAUNCH_CONTEXT = re.compile(
    r"(?:\bAMA\b|Twitter\s+Space|X\s+Space|\bSpaces?\b|spaces\.x\.com|"
    r"join\s+(?:a\s+)?space|join\s+(?:us\s+)?(?:for\s+)?(?:an?\s+)?AMA|"
    r"hosting\s+(?:an?\s+)?AMA|Space\s+with|"
    r"直播|语音|播客|听.{0,24}拆解|深度拆解|"
    r"going\s+live\s+(?:on\s+)?(?:X|Twitter)\s+Space)",
    re.I,
)


def is_non_launch_event(ctx: str) -> bool:
    """True when surrounding text is clearly AMA/Space/直播, not token launch."""
    if not ctx:
        return False
    return bool(NON_LAUNCH_CONTEXT.search(ctx))


def now_sh() -> datetime:
    return datetime.now(TZ)


def iso_sh(dt: datetime) -> str:
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=TZ)
    return dt.astimezone(TZ).isoformat(timespec="seconds")


def load_json(path: Path, default: Any) -> Any:
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def write_json(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def strip_html(body: str) -> str:
    text = re.sub(r"(?is)<(script|style)[^>]*>.*?</\1>", " ", body)
    text = re.sub(r"(?is)<[^>]+>", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def fetch_site(url: str, max_bytes: int = 400_000) -> str:
    if not url or "…" in url or "x.com/" in url or "twitter.com/" in url:
        return ""
    try:
        out = subprocess.run(
            ["curl", "-sS", "-L", "--max-time", "20", "-A", UA,
             "--max-filesize", str(max_bytes), url],
            capture_output=True, text=True, timeout=28,
        )
        if out.returncode != 0:
            return ""
        return strip_html(out.stdout or "")[:80_000]
    except Exception:
        return ""


def month_num(name: str) -> int | None:
    k = name.lower().rstrip(".")
    if k.startswith("sept"):
        return 9
    return MONTH_EN.get(k) or MONTH_EN.get(k[:3])


def parse_clock(hm: str | None, ampm: str | None) -> tuple[int, int] | None:
    if not hm:
        return None
    m = re.match(r"^(\d{1,2})(?::(\d{2}))?$", hm.strip())
    if not m:
        return None
    h = int(m.group(1))
    mi = int(m.group(2) or 0)
    if ampm:
        ap = ampm.lower().replace(".", "")
        if ap.startswith("p") and h < 12:
            h += 12
        elif ap.startswith("a") and h == 12:
            h = 0
    if not (0 <= h <= 23 and 0 <= mi <= 59):
        return None
    return h, mi


def apply_tz_label(dt: datetime, label: str | None) -> datetime:
    if dt.tzinfo is not None:
        return dt.astimezone(TZ)
    lab = (label or "").upper().replace(" ", "")
    if lab in ("UTC", "GMT", "Z"):
        return dt.replace(tzinfo=timezone.utc).astimezone(TZ)
    if lab in ("EST", "EDT"):
        off = -4 if ("D" in lab or now_sh().month in range(3, 11)) else -5
        return dt.replace(tzinfo=timezone(timedelta(hours=off))).astimezone(TZ)
    if lab in ("PST", "PDT"):
        off = -7 if ("D" in lab or now_sh().month in range(3, 11)) else -8
        return dt.replace(tzinfo=timezone(timedelta(hours=off))).astimezone(TZ)
    if lab == "CST":
        return dt.replace(tzinfo=TZ)
    if lab == "CEST":
        return dt.replace(tzinfo=timezone(timedelta(hours=2))).astimezone(TZ)
    if lab == "CET":
        return dt.replace(tzinfo=timezone(timedelta(hours=1))).astimezone(TZ)
    m = re.match(r"(?:GMT|UTC)([+-])(\d{1,2})(?::?(\d{2}))?", lab)
    if m:
        sign = 1 if m.group(1) == "+" else -1
        hh = int(m.group(2))
        mm = int(m.group(3) or 0)
        return dt.replace(
            tzinfo=timezone(timedelta(hours=sign * hh, minutes=sign * mm))
        ).astimezone(TZ)
    return dt.replace(tzinfo=TZ)


def label_tzinfo(label: str | None):
    """tzinfo for a zone label (UTC/GMT+3/CEST...), default Asia/Shanghai."""
    if not label:
        return TZ
    probe = datetime(2026, 10, 20, 12, 0)
    d = apply_tz_label(probe, label)
    off = probe - d.astimezone(timezone.utc).replace(tzinfo=None)
    return timezone(off)


def snip(text: str, start: int, end: int, width: int = 90) -> str:
    a = max(0, start - width)
    b = min(len(text), end + width)
    return re.sub(r"\s+", " ", text[a:b]).strip()[:220]


def year_for(month: int, day: int, ref: datetime) -> int:
    y = ref.year
    try:
        candidate = datetime(y, month, day, tzinfo=TZ)
    except ValueError:
        return y
    if candidate < ref - timedelta(days=45):
        return y + 1
    return y


Candidate = dict[str, Any]


def add_cand(
    out: list[Candidate],
    dt: datetime | None,
    raw: str,
    source: str,
    evidence_url: str,
    confidence: str,
    *,
    already: bool = False,
    note: str = "",
    has_clock: bool = False,
) -> None:
    out.append({
        "listing_at": iso_sh(dt) if dt else None,
        "listing_at_raw": (raw or "")[:220],
        "source": source,
        "evidence_url": evidence_url or "",
        "confidence": confidence,
        "already_listed": already,
        "note": note,
        "has_clock": has_clock,
        "_rank": CONF_RANK.get(confidence, 0) + (2 if has_clock else 0) + (1 if dt else 0),
    })


def extract_from_text(
    text: str,
    source: str,
    evidence_url: str,
    ref: datetime | None = None,
) -> list[Candidate]:
    if not text:
        return []
    ref = ref or now_sh()
    found: list[Candidate] = []
    t = text

    for m in ALREADY_LISTED_RE.finditer(t):
        add_cand(
            found, None, snip(t, m.start(), m.end()), source, evidence_url,
            "medium", already=True, note="already_listed_keyword",
        )

    # ISO: 2026-10-21 15:00 UTC
    for m in re.finditer(
        r"(?P<y>20\d{2})[-/](?P<mo>\d{1,2})[-/](?P<d>\d{1,2})"
        r"(?:[ T](?P<h>\d{1,2}):(?P<mi>\d{2})(?::\d{2})?)?"
        r"(?:\s*(?P<tz>UTC|GMT(?:[+-]\d{1,2})?|CST|EST|EDT|PST|PDT|CEST|CET))?",
        t, re.I,
    ):
        try:
            y, mo, d = int(m.group("y")), int(m.group("mo")), int(m.group("d"))
            hh = int(m.group("h") or 0)
            mi = int(m.group("mi") or 0)
            dt = apply_tz_label(datetime(y, mo, d, hh, mi), m.group("tz"))
            ctx = snip(t, m.start(), m.end())
            has_clock = bool(m.group("h"))
            if has_clock:
                conf = "high"
            elif LAUNCH_CONTEXT.search(ctx):
                conf = "medium"
            else:
                conf = "low"
            add_cand(found, dt, ctx, source, evidence_url, conf, has_clock=has_clock)
        except Exception:
            pass

    # Chinese: 10月27日 13:00 / 计划10月27日开铸
    for m in re.finditer(
        r"(?:(?P<y>20\d{2})\s*年\s*)?(?P<mo>\d{1,2})\s*月\s*(?P<d>\d{1,2})\s*日?"
        r"(?:\s*(?P<h>\d{1,2})\s*[点:：]\s*(?P<mi>\d{1,2})?)?",
        t,
    ):
        try:
            mo, d = int(m.group("mo")), int(m.group("d"))
            y = int(m.group("y")) if m.group("y") else year_for(mo, d, ref)
            hh = int(m.group("h") or 0)
            mi = int(m.group("mi") or 0) if m.group("h") else 0
            dt = datetime(y, mo, d, hh, mi, tzinfo=TZ)
            ctx = snip(t, m.start(), m.end(), 120)
            if not LAUNCH_CONTEXT.search(ctx) and not m.group("h"):
                continue
            conf = "high" if m.group("h") else "medium"
            add_cand(found, dt, ctx, source, evidence_url, conf, has_clock=bool(m.group("h")))
        except Exception:
            pass

    # English Month Day: Oct 21 · 06:00 UTC / OCTOBER 21st⏰ 19:00 CEST / Mint Date: Oct 22
    for m in re.finditer(
        r"(?:(?P<label>Mint\s*Date|Launch(?:es|ing)?|TGE|opens?|Open(?:s|ing)?|Mainnet)\s*[:\-]?\s*)?"
        r"(?P<mon>Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|"
        r"Aug(?:ust)?|Sep(?:t(?:ember)?)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)"
        r"\.?\s+(?P<d>\d{1,2})(?:st|nd|rd|th)?"
        r"(?:,?\s*(?P<y>20\d{2}))?"
        r"(?:[\s\S]{0,20}?(?:at\s+)?"
        r"(?P<h>\d{1,2})(?:(?::(?P<mi>\d{2}))\s*(?P<ampm>[AaPp]\.?[Mm]\.?)?|\s*(?P<ampm2>[AaPp]\.?[Mm]\.?))(?![\d,])"
        r"(?:\s*(?P<tz>UTC|GMT(?:[+-]\d{1,2})?|CST|EST|EDT|PST|PDT|CEST|CET))?)?",
        t, re.I,
    ):
        try:
            if re.search(r"\bJoined\b", snip(t, m.start(), m.end(), 30), re.I):
                continue
            mo = month_num(m.group("mon"))
            if not mo:
                continue
            d = int(m.group("d"))
            y = int(m.group("y")) if m.group("y") else year_for(mo, d, ref)
            clock = parse_clock(
                (m.group("h") or "") + (f":{m.group('mi')}" if m.group("mi") else ""),
                m.group("ampm") or m.group("ampm2"),
            )
            hh, mi = clock if clock else (0, 0)
            dt = apply_tz_label(datetime(y, mo, d, hh, mi), m.group("tz"))
            ctx = snip(t, m.start(), m.end())
            has_l = bool(m.group("label")) or bool(LAUNCH_CONTEXT.search(ctx))
            if clock and (has_l or m.group("tz")):
                conf = "high"
            elif has_l:
                conf = "high" if clock else "medium"
            elif clock:
                conf = "medium"
            else:
                conf = "low"
            # Pinned tweet chrome / PRE-TGE airdrop date without mint/launch verb
            if conf != "high" and re.search(r"Pinned|PRE-TGE|Airdrop Giveaway", ctx, re.I):
                continue
            if not has_l and not clock:
                continue
            add_cand(found, dt, ctx, source, evidence_url, conf, has_clock=bool(clock))
        except Exception:
            pass

    # Day Month: 20 October, at 9 PM UTC
    for m in re.finditer(
        r"(?P<d>\d{1,2})(?:st|nd|rd|th)?\s+"
        r"(?P<mon>Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|"
        r"Aug(?:ust)?|Sep(?:t(?:ember)?)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)"
        r"\.?(?:,?\s*(?P<y>20\d{2}))?"
        r"(?:\s*,?\s*(?:at\s+)?"
        r"(?P<h>\d{1,2})(?::(?P<mi>\d{2}))?\s*(?P<ampm>[AaPp]\.?[Mm]\.?)?"
        r"(?:\s*(?P<tz>UTC|GMT(?:[+-]\d{1,2})?|CST|EST|EDT|PST|PDT|CEST|CET))?)?",
        t, re.I,
    ):
        try:
            mo = month_num(m.group("mon"))
            if not mo:
                continue
            d = int(m.group("d"))
            y = int(m.group("y")) if m.group("y") else year_for(mo, d, ref)
            clock = parse_clock(
                (m.group("h") or "") + (f":{m.group('mi')}" if m.group("mi") else ""),
                m.group("ampm"),
            )
            hh, mi = clock if clock else (0, 0)
            dt = apply_tz_label(datetime(y, mo, d, hh, mi), m.group("tz"))
            ctx = snip(t, m.start(), m.end())
            if not LAUNCH_CONTEXT.search(ctx) and not clock:
                continue
            conf = "high" if (clock and m.group("tz")) else ("high" if clock else "medium")
            add_cand(found, dt, ctx, source, evidence_url, conf, has_clock=bool(clock))
        except Exception:
            pass

    # Relative Chinese
    rel_cn = {"今日": 0, "今天": 0, "今晚": 0, "明天": 1, "明日": 1, "后天": 2}
    for word, days in rel_cn.items():
        for m in re.finditer(
            rf"{word}(?:\s*(?:开盘|开铸|发射|上线|开售))?"
            rf"(?:\s*(?P<h>\d{{1,2}})\s*[点:：]\s*(?P<mi>\d{{1,2}})?)?",
            t,
        ):
            ctx = snip(t, m.start(), m.end(), 140)
            if is_non_launch_event(ctx):
                continue
            # tonight/today + clock alone is not enough (AMA posts often say 今晚 HH:MM)
            if not LAUNCH_CONTEXT.search(ctx):
                continue
            if word == "今晚" and not m.group("h"):
                hh, mi = 20, 0
            else:
                hh = int(m.group("h") or 0)
                mi = int(m.group("mi") or 0) if m.group("h") else 0
            base = (ref + timedelta(days=days)).replace(
                hour=hh, minute=mi, second=0, microsecond=0
            )
            conf = "medium" if (m.group("h") or word in ("今晚", "明天", "后天")) else "low"
            add_cand(
                found, base, ctx, source, evidence_url, conf,
                has_clock=bool(m.group("h") or word == "今晚"),
                note=f"relative:{word}",
            )

    # Relative English
    for word, days, default_h in (("tonight", 0, 20), ("tomorrow", 1, 0), ("today", 0, 0)):
        for m in re.finditer(
            rf"\b{word}\b(?:\s+(?:at\s+)?"
            rf"(?P<h>\d{{1,2}})(?::(?P<mi>\d{{2}}))?\s*(?P<ampm>[AaPp]\.?[Mm]\.?)?"
            rf"(?:\s*(?P<tz>UTC|GMT|EST|EDT|PST|PDT|CEST|CET))?)?",
            t, re.I,
        ):
            ctx = snip(t, m.start(), m.end(), 140)
            if is_non_launch_event(ctx):
                continue
            clock = parse_clock(
                (m.group("h") or "") + (f":{m.group('mi')}" if m.group("mi") else ""),
                m.group("ampm"),
            )
            # tonight/today + clock without launch words → skip (AMA/Spaces false positives)
            if not LAUNCH_CONTEXT.search(ctx):
                continue
            # explicit "HH:MM UTC" nearby → let the clock parser own it
            if not clock and re.search(r"\d{1,2}:\d{2}\s*(UTC|GMT|CEST|CET|EST|EDT|PST|PDT)", ctx, re.I):
                continue
            if not clock and word == "tomorrow" and re.search(
                r"tomorrow (we |the website|i |i'm |im )", ctx, re.I
            ):
                continue
            if clock:
                hh, mi = clock
            elif word == "tonight":
                hh, mi = default_h, 0
            else:
                hh, mi = 0, 0
            ref_z = ref.astimezone(label_tzinfo(m.group("tz")))
            dt = (ref_z + timedelta(days=days)).replace(
                hour=hh, minute=mi, second=0, microsecond=0
            ).astimezone(TZ)
            conf = "high" if (clock and m.group("tz")) else (
                "medium" if (clock or word in ("tonight", "tomorrow")) else "low"
            )
            add_cand(
                found, dt, ctx, source, evidence_url, conf,
                has_clock=bool(clock or word == "tonight"),
                note=f"relative:{word}",
            )

    # HH:MM UTC near launch (Cropz: TONIGHT … 18:00 UTC)
    for m in re.finditer(
        r"(?P<h>\d{1,2}):(?P<mi>\d{2})\s*(?P<tz>UTC|GMT(?:[+-]\d{1,2})?|CEST|CET|EST|EDT|PST|PDT)",
        t, re.I,
    ):
        ctx = snip(t, m.start(), m.end(), 140)
        if not LAUNCH_CONTEXT.search(ctx):
            continue
        if re.search(r"unlocks?|vesting|race resets", ctx, re.I):
            continue
        # If absolute calendar date already in context, let that parser own the clock
        if re.search(
            r"(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\.?\s+\d{1,2}"
            r"|\d{1,2}\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)"
            r"|\d{1,2}\s*月\s*\d{1,2}"
            r"|20\d{2}-\d{2}-\d{2}",
            ctx, re.I,
        ):
            continue
        try:
            hh, mi = int(m.group("h")), int(m.group("mi"))
            day_off = 0
            if re.search(r"\btomorrow\b|明天", ctx, re.I):
                day_off = 1
            # Resolve "tonight/today" in the zone the clock is written in (post date in UTC etc.)
            ref_z = ref.astimezone(label_tzinfo(m.group("tz")))
            base = (ref_z + timedelta(days=day_off)).replace(
                hour=hh, minute=mi, second=0, microsecond=0
            )
            dt = base.astimezone(TZ)
            add_cand(
                found, dt, ctx, source, evidence_url, "high",
                has_clock=True, note="clock_utc_near_launch",
            )
        except Exception:
            pass

    # in N hours / couple of hours
    for m in re.finditer(
        r"\bin\s*(?:~|about|around)?\s*(?P<n>\d+)\s*hours?\b|"
        r"\bin\s+a\s+couple\s+of\s+hours\b|"
        r"\b(?P<n2>\d+)\s+hours?\s+left\b",
        t, re.I,
    ):
        n = m.group("n") or m.group("n2")
        hours = int(n) if n else 2
        if hours > 72:
            continue
        ctx = snip(t, m.start(), m.end(), 160)
        if not re.search(r"live|launch|mint|开盘|上线|wallet", ctx, re.I):
            continue
        dt = ref + timedelta(hours=hours)
        add_cand(
            found, dt, ctx, source, evidence_url, "medium",
            has_clock=True, note=f"relative_hours:{hours}",
        )

    # Mainnet Nov 1st
    for m in re.finditer(
        r"(?P<label>Mainnet|TGE|Launch|Mint)\s+"
        r"(?P<mon>Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|"
        r"Aug(?:ust)?|Sep(?:t(?:ember)?)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)"
        r"\.?\s+(?P<d>\d{1,2})(?:st|nd|rd|th)?",
        t, re.I,
    ):
        try:
            mo = month_num(m.group("mon"))
            d = int(m.group("d"))
            y = year_for(mo, d, ref)
            dt = datetime(y, mo, d, 0, 0, tzinfo=TZ)
            ctx = snip(t, m.start(), m.end())
            add_cand(found, dt, ctx, source, evidence_url, "medium", has_clock=False)
        except Exception:
            pass

    cleaned: list[Candidate] = []
    for c in found:
        raw = c.get("listing_at_raw") or ""
        if is_non_launch_event(raw):
            continue
        if re.search(r"\bJoined\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)", raw, re.I):
            continue
        if re.search(r"unlocks?|vesting|locked on|race resets", raw, re.I) and not re.search(
            r"\b(mint|launch|tge|开盘|开铸)\b", raw, re.I
        ):
            continue
        if c.get("listing_at"):
            try:
                dt = datetime.fromisoformat(c["listing_at"])
                if dt < ref - timedelta(days=60) and not c.get("has_clock"):
                    continue
                if dt > ref + timedelta(days=180) and not c.get("has_clock"):
                    continue
            except Exception:
                pass
        cleaned.append(c)
    return cleaned


def best_candidate(cands: list[Candidate]) -> Candidate | None:
    if not cands:
        return None
    now = now_sh()
    timed = [c for c in cands if c.get("listing_at")]
    already = [c for c in cands if c.get("already_listed") and not c.get("listing_at")]

    def score(c: Candidate) -> tuple:
        dt_s = c.get("listing_at")
        dt = datetime.fromisoformat(dt_s) if dt_s else None
        future = 1 if dt and dt >= now - timedelta(hours=1) else 0
        clock = 1 if c.get("has_clock") else 0
        note = c.get("note") or ""
        penalty = 0
        if dt and dt < now - timedelta(hours=1) and note.startswith("relative"):
            penalty = -3
        return (
            c.get("_rank", 0) + penalty,
            future,
            clock,
            -(abs((dt - now).total_seconds()) if dt else 10**12),
        )

    if timed:
        timed.sort(key=score, reverse=True)
        return timed[0]
    if already:
        return already[0]
    return None


def is_better(new: Candidate, old: dict) -> bool:
    old_at = old.get("listing_at")
    new_at = new.get("listing_at")
    if not new_at:
        return False
    if not old_at:
        return True
    old_conf = CONF_RANK.get(old.get("listing_at_confidence") or old.get("confidence") or "low", 0)
    new_conf = CONF_RANK.get(new.get("confidence") or "low", 0)
    if new_conf > old_conf:
        return True
    if new_conf < old_conf:
        return False
    try:
        od = datetime.fromisoformat(old_at)
        nd = datetime.fromisoformat(new_at)
    except Exception:
        return False
    if od.date() == nd.date():
        old_precise = not (od.hour == 0 and od.minute == 0)
        new_precise = bool(new.get("has_clock")) or not (nd.hour == 0 and nd.minute == 0)
        if new_precise and not old_precise:
            return True
        if new_precise and old_precise:
            return True
    # 延期 / reschedule: same UTC calendar day with clocks, or official later time
    # when sticky time already passed (crosses Asia/Shanghai midnight, e.g. 06:00→18:00 UTC).
    try:
        od_utc = od.astimezone(timezone.utc)
        nd_utc = nd.astimezone(timezone.utc)
        now = datetime.now(TZ)
        old_precise = not (od.hour == 0 and od.minute == 0)
        new_precise = bool(new.get("has_clock")) or not (nd.hour == 0 and nd.minute == 0)
        if new_precise and old_precise and od_utc.date() == nd_utc.date() and nd != od:
            return True
        if new_precise and nd > od and od < now <= nd + timedelta(days=3):
            # sticky time missed; new evidence pushes launch into next 3 days
            return True
    except Exception:
        pass
    old_note = (old.get("listing_at_note") or old.get("note") or "")
    if old_note.startswith("relative") and new_conf >= old_conf and new.get("has_clock"):
        return True
    return False


def gather_texts(
    proj: dict,
    x_users: dict,
    x_listing: dict,
    listing_by_handle: dict,
    tg_by_handle: dict,
    tg_by_name: dict,
) -> list[tuple[str, str, str, datetime | None]]:
    blobs: list[tuple[str, str, str, datetime | None]] = []
    handle = (proj.get("handle") or "").lstrip("@")
    name = proj.get("name") or ""

    wl_bits = " ".join(
        str(proj.get(k) or "")
        for k in ("listing", "status", "listing_signal", "onchain_notes", "mint")
    )
    if wl_bits.strip() and not VAGUE_ONLY.match(wl_bits.strip()):
        blobs.append((wl_bits, "watchlist", proj.get("x_url") or "", None))

    tg = tg_by_handle.get(handle.lower()) or tg_by_name.get(name)
    if tg:
        parts = [
            tg.get("raw_text") or "",
            tg.get("summary_cn") or "",
            tg.get("summary_en") or "",
            tg.get("risk") or "",
        ]
        text = "\n".join(p for p in parts if p)
        if text.strip():
            blobs.append((text, "tg", proj.get("x_url") or "", None))

    lr = listing_by_handle.get(handle.lower())
    if lr:
        for s in lr.get("signals") or []:
            sn = s.get("snippet") or ""
            src = s.get("source") or "site"
            url = ""
            if isinstance(src, str) and src.startswith("site:"):
                url = src[5:]
                source = "site"
            elif isinstance(src, str) and src.startswith("x"):
                source = "x"
                url = proj.get("x_url") or ""
            else:
                source = "tg" if src == "tg" else "site"
            if sn:
                blobs.append((sn, source, url, None))

    xu = None
    for k, v in x_users.items():
        if k.lower() == handle.lower():
            xu = v
            break
    if xu:
        bio = xu.get("description") or ""
        if bio:
            blobs.append((bio, "x", proj.get("x_url") or f"https://x.com/{handle}", None))
        for p in xu.get("posts") or []:
            txt = p.get("text") or ""
            if not txt:
                continue
            ref = None
            created = p.get("created_at")
            if created:
                try:
                    ref = datetime.fromisoformat(created.replace("Z", "+00:00")).astimezone(TZ)
                except Exception:
                    ref = None
            blobs.append((txt, "x", p.get("url") or f"https://x.com/{handle}", ref))

    for p in x_listing.get(handle.lower()) or []:
        txt = p.get("text") or ""
        if not txt:
            continue
        ref = None
        created = p.get("created_at")
        if created:
            try:
                ref = datetime.fromisoformat(created.replace("Z", "+00:00")).astimezone(TZ)
            except Exception:
                ref = None
        blobs.append((txt, "x", p.get("url") or "", ref))

    return blobs


def clear_ama_false_positive(proj: dict, raw: str | None = None) -> bool:
    """Clear sticky listing_at when evidence is clearly AMA/Space (not 开盘).

    Sticky "never wipe" does NOT protect confirmed non-launch events (user).
    Keeps listing_at_raw / evidence_url for audit; sets note rejected:ama_space.
    """
    handle = (proj.get("handle") or "").lstrip("@").lower()
    raw = raw if raw is not None else (proj.get("listing_at_raw") or "")
    if not proj.get("listing_at") and proj.get("listing_at_note") == "rejected:ama_space":
        return False
    ama = bool(raw) and is_non_launch_event(raw) and not LAUNCH_CONTEXT.search(raw)
    # one-shot: TapeOracle Space post mislabeled as listing
    if not ama and handle == "0xtapeoracle" and raw and not LAUNCH_CONTEXT.search(raw):
        if "今晚" in raw or "20:30" in raw or "拆解" in raw:
            ama = True
    if not ama:
        return False
    proj["listing_at"] = None
    proj["listing_at_display"] = "未知"
    proj["listing_at_note"] = "rejected:ama_space"
    if raw:
        proj["listing_at_raw"] = raw
    return True


def sticky_merge_project(proj: dict, new: Candidate | None, now: datetime) -> dict:
    """Sticky fill-forward into proj; return listing_times item."""
    old_at = proj.get("listing_at")

    # Confirmed AMA/Space: wipe sticky false positive before fill-forward
    if clear_ama_false_positive(proj):
        old_at = None

    if new and new.get("listing_at") and (not old_at or is_better(new, proj)):
        # Never re-sticky an AMA-derived candidate
        if is_non_launch_event(new.get("listing_at_raw") or ""):
            pass
        else:
            proj["listing_at"] = new["listing_at"]
            proj["listing_at_source"] = new.get("source")
            proj["listing_at_raw"] = new.get("listing_at_raw")
            proj["listing_at_confidence"] = new.get("confidence")
            proj["listing_at_evidence_url"] = new.get("evidence_url") or ""
            if new.get("note"):
                proj["listing_at_note"] = new["note"]
            else:
                proj.pop("listing_at_note", None)
    elif new and new.get("already_listed") and not old_at:
        # keyword-only already listed: keep listing_at null, note it
        proj["listing_at"] = None
        proj["listing_at_source"] = new.get("source")
        proj["listing_at_raw"] = new.get("listing_at_raw")
        proj["listing_at_confidence"] = new.get("confidence") or "medium"
        proj["listing_at_evidence_url"] = new.get("evidence_url") or ""
        proj["listing_at_note"] = "already_listed_keyword"
    # else: keep previous listing_at sticky — never wipe to null
    # (exception: AMA/Space clear above)

    listing_at = proj.get("listing_at")
    already = False
    listing_field = proj.get("listing") or ""
    if listing_field in ("已开盘", "已上线"):
        already = True
    if proj.get("listing_at_note") == "already_listed_keyword":
        already = True
    if new and new.get("already_listed") and not listing_at:
        already = True
    # mint-only "live now" should not count as token 开盘
    raw_al = (proj.get("listing_at_raw") or "")
    if already and re.search(r"mint\s+is\s+live|minting\s+now|public\s+mint", raw_al, re.I) \
            and not re.search(r"已开盘|开始交易|trading\s+(now|live)|token\s+live", raw_al, re.I):
        already = False
    if listing_at:
        try:
            dt = datetime.fromisoformat(listing_at)
            if dt < now - timedelta(hours=6) and CONF_RANK.get(
                proj.get("listing_at_confidence") or "low", 0
            ) >= 2:
                already = True
        except Exception:
            pass

    within = False
    if listing_at and not already:
        try:
            dt = datetime.fromisoformat(listing_at)
            within = now <= dt <= now + timedelta(days=3)
        except Exception:
            within = False

    # display: real ISO or 未知 — never blank
    display = listing_at if listing_at else "未知"
    proj["listing_at_display"] = display

    # Card listing field: only promote to 已开盘 when clearly listed AND we had 未开盘/不明
    # Do not use 未知 for the card listing field (那是时间展示)
    if already and listing_field in ("未开盘", "不明", "") and re.search(
        r"已开盘|开始交易|trading\\s+(now|live)|token\\s+(is\\s+)?live", proj.get("listing_at_raw") or "", re.I
    ):
        proj["listing"] = "已开盘"

    return {
        "project": proj.get("name"),
        "handle": proj.get("handle"),
        "listing_at": listing_at,
        "listing_at_display": display,
        "listing_at_raw": proj.get("listing_at_raw") or "",
        "source": proj.get("listing_at_source") or "",
        "evidence_url": proj.get("listing_at_evidence_url") or "",
        "confidence": proj.get("listing_at_confidence") or ("low" if not listing_at else "medium"),
        "already_listed": already,
        "within_next_3_days": within,
        "note": proj.get("listing_at_note") or "",
    }


def load_tg() -> tuple[dict, dict]:
    by_h: dict[str, dict] = {}
    by_n: dict[str, dict] = {}
    if TG_JSONL.exists():
        for line in TG_JSONL.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                j = json.loads(line)
            except Exception:
                continue
            h = (j.get("twitter_handle") or j.get("handle") or "").lstrip("@")
            if h:
                by_h[h.lower()] = j
            if j.get("name"):
                by_n[j["name"]] = j
    pj = load_json(TG_PROJECTS, None)
    projects = []
    if isinstance(pj, list):
        projects = pj
    elif isinstance(pj, dict):
        projects = pj.get("projects") or pj.get("items") or []
    for j in projects:
        h = (j.get("twitter_handle") or j.get("handle") or "").lstrip("@")
        if h and h.lower() not in by_h:
            by_h[h.lower()] = j
        if j.get("name") and j["name"] not in by_n:
            by_n[j["name"]] = j
    return by_h, by_n


def sticky_enrich_candidate(c: dict, it: dict | None) -> None:
    """Apply sticky rules onto one candidates.json row."""
    if not it:
        if not c.get("listing_at"):
            c["listing_at"] = None
            c["listing_at_display"] = "未知"
        else:
            c["listing_at_display"] = c["listing_at"]
        return

    new = {
        "listing_at": it["listing_at"],
        "confidence": it["confidence"],
        "has_clock": bool(it.get("listing_at") and not str(it["listing_at"]).endswith("T00:00:00+08:00")),
        "note": it.get("note") or "",
        "listing_at_raw": it.get("listing_at_raw"),
        "source": it.get("source"),
        "evidence_url": it.get("evidence_url"),
    }
    old_at = c.get("listing_at")
    # Propagate AMA rejection clears (sticky exception)
    if it.get("note") == "rejected:ama_space" or (
        not it.get("listing_at") and is_non_launch_event(it.get("listing_at_raw") or "")
    ):
        c["listing_at"] = None
        c["listing_at_display"] = "未知"
        c["listing_at_note"] = "rejected:ama_space"
        if it.get("listing_at_raw"):
            c["listing_at_raw"] = it["listing_at_raw"]
        if it.get("evidence_url"):
            c["listing_at_evidence_url"] = it["evidence_url"]
        if it.get("source"):
            c["listing_at_source"] = it["source"]
        c["within_next_3_days"] = False
        old_at = None
    if it["listing_at"] and (not old_at or is_better(new, c)):
        c["listing_at"] = it["listing_at"]
        c["listing_at_source"] = it["source"]
        c["listing_at_raw"] = it["listing_at_raw"]
        c["listing_at_confidence"] = it["confidence"]
        c["listing_at_evidence_url"] = it["evidence_url"]
        c["listing_at_display"] = it["listing_at"]
        if it.get("note"):
            c["listing_at_note"] = it["note"]
    elif old_at:
        c["listing_at_display"] = old_at
    else:
        c["listing_at"] = None
        c["listing_at_display"] = "未知"
        if it.get("listing_at_raw"):
            c["listing_at_raw"] = it["listing_at_raw"]
            c["listing_at_source"] = it.get("source") or ""
            c["listing_at_confidence"] = it.get("confidence") or "low"
    c["already_listed"] = it["already_listed"]
    c["within_next_3_days"] = it["within_next_3_days"]
    if it["already_listed"] and c.get("listing") in ("未开盘", "不明", "") and re.search(
        r"已开盘|开始交易|trading\\s+(now|live)|token\\s+(is\\s+)?live", it.get("listing_at_raw") or "", re.I
    ):
        c["listing"] = "已开盘"


def main() -> int:
    now = now_sh()
    wl = load_json(WATCHLIST, {})
    projects = wl.get("projects") or []
    x_cache = load_json(X_CACHE, {})
    x_users = x_cache.get("users") or {}
    x_listing = (load_json(X_LISTING, {}) or {}).get("users") or {}
    listing_scan = load_json(LISTING_SCAN, {})
    listing_by_handle = {
        (r.get("handle") or "").lower(): r
        for r in (listing_scan.get("results") or [])
        if r.get("handle")
    }
    tg_by_h, tg_by_n = load_tg()

    need_fetch = []
    for p in projects:
        if p.get("listing_at"):
            continue
        if p.get("status") in ("即将启动", "mint进行中") or "即将" in str(p.get("listing_signal") or ""):
            for s in p.get("sites") or []:
                if s and "x.com" not in s and "t.me" not in s and "…" not in s:
                    need_fetch.append((p, s))
                    break

    site_extra: dict[str, str] = {}
    for p, url in need_fetch[:40]:
        text = fetch_site(url)
        if text:
            site_extra[(p.get("handle") or "").lower()] = text

    items = []
    parseable = 0
    within_list = []
    already_n = 0
    ambiguous = []

    for proj in projects:
        handle = (proj.get("handle") or "").lstrip("@")
        blobs = gather_texts(proj, x_users, x_listing, listing_by_handle, tg_by_h, tg_by_n)
        extra = site_extra.get(handle.lower())
        if extra:
            site_url = next(
                (s for s in (proj.get("sites") or [])
                 if s and "x.com" not in s and "…" not in s),
                "",
            )
            blobs.append((extra, "site", site_url, None))

        all_cands: list[Candidate] = []
        for text, source, url, ref in blobs:
            all_cands.extend(extract_from_text(text, source, url, ref or now))

        filtered = []
        for c in all_cands:
            raw = (c.get("listing_at_raw") or "")
            if re.search(r"this week|launching this week|本周", raw, re.I) and not c.get("listing_at"):
                ambiguous.append({
                    "project": proj.get("name"),
                    "handle": handle,
                    "reason": "keyword_only_no_date",
                    "raw": raw[:120],
                })
                continue
            filtered.append(c)

        best = best_candidate(filtered)
        item = sticky_merge_project(proj, best, now)
        items.append(item)
        if item["listing_at"]:
            parseable += 1
        if item["within_next_3_days"]:
            within_list.append(item)
        if item["already_listed"]:
            already_n += 1
        if not item["listing_at"] and any(c.get("already_listed") for c in filtered):
            ambiguous.append({
                "project": proj.get("name"),
                "handle": handle,
                "reason": "already_listed_no_datetime",
                "raw": next(
                    (c.get("listing_at_raw") for c in filtered if c.get("already_listed")),
                    "",
                )[:120],
            })

    # Ensure every project has display 未知 or real time
    assert all(i.get("listing_at_display") for i in items)

    out = {
        "generated_at": iso_sh(now),
        "timezone": "Asia/Shanghai",
        "count": len(items),
        "parseable_count": parseable,
        "within_next_3_days_count": len(within_list),
        "already_listed_count": already_n,
        "items": items,
        "within_next_3_days": [
            {
                "project": x["project"],
                "handle": x["handle"],
                "listing_at": x["listing_at"],
                "source": x["source"],
                "confidence": x["confidence"],
                "listing_at_raw": x["listing_at_raw"],
                "evidence_url": x["evidence_url"],
            }
            for x in sorted(within_list, key=lambda z: z["listing_at"] or "")
        ],
        "sticky_rule": (
            "fill-forward: never wipe listing_at to null/未知 once set; "
            "missing this run keeps previous; listing_at_display=未知 only when listing_at is null; "
            "exception: AMA/Space/直播 evidence clears sticky false positives (note=rejected:ama_space)"
        ),
    }
    write_json(OUT, out)
    write_json(OUT_MIRROR, out)

    wl["updated_at"] = iso_sh(now)
    wl["last_listing_times_at"] = iso_sh(now)
    write_json(WATCHLIST, wl)

    cand = load_json(CANDIDATES, {})
    by_h = {(it["handle"] or "").lower(): it for it in items if it.get("handle")}
    for c in cand.get("candidates") or []:
        h = (c.get("handle") or "").lstrip("@").lower()
        sticky_enrich_candidate(c, by_h.get(h))
    cand["listing_times_at"] = iso_sh(now)
    write_json(CANDIDATES, cand)

    print(f"generated_at={out['generated_at']}")
    print(f"parseable={parseable}/{len(items)} already_listed={already_n} within_3d={len(within_list)}")
    print("--- within_next_3_days ---")
    for x in out["within_next_3_days"]:
        print(
            f"  {x['listing_at']}  {x['project']} (@{x['handle']})  "
            f"[{x['confidence']}/{x['source']}]  {x['listing_at_raw'][:90]}"
        )
    print("--- sample best ---")
    bests = [i for i in items if i["listing_at"] and i["confidence"] == "high"]
    bests = sorted(bests, key=lambda z: z["listing_at"] or "")[:5]
    if len(bests) < 5:
        bests = sorted(
            [i for i in items if i["listing_at"]],
            key=lambda z: CONF_RANK.get(z["confidence"], 0),
            reverse=True,
        )[:5]
    for i in bests:
        print(json.dumps(i, ensure_ascii=False))
    print("--- ambiguous (top 12) ---")
    for a in ambiguous[:12]:
        print(json.dumps(a, ensure_ascii=False))
    unknown_n = sum(1 for i in items if i["listing_at_display"] == "未知")
    print(f"display_未知={unknown_n} display_timed={len(items)-unknown_n}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
