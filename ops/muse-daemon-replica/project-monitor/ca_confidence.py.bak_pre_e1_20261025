#!/usr/bin/env python3
"""CA confidence model — decides whether a found address is a *confirmed* CA.

P0 rules kept. P1 (开盘前精准锁定) additions:
  - wallet_factory only when deployer is a REAL watched wallet (TapeOut set or
    watched_wallets/wallet_watchlist with confidence). A reason string containing
    "wallet" is NOT enough (fixes backtest_inject / weak-path false confirmed).
  - high-confidence watched deployer is a hard evidence; medium/low is soft only
    (candidate, never alone or with name-match → confirmed).
  - Name/symbol match is NEVER hard evidence (assist_only → suspected_copycat alone).
  - Pre-launch confirmed (no official_x) requires >=2 independent hard evidences.
  - Official X is verification, not a mandatory trigger gate; official_x alone still
    confirms (事后验证), so existing X-confirmed rows stay.
  - Conflicts (two different CAs with evidence for same project): conflict=True,
    ca_status stays candidate, never auto-confirm either.
"""
from __future__ import annotations

STATUS_LABEL = {
    "confirmed": "已确认CA",
    "superseded": "非正式·官推未认",
    "suspected_copycat": "疑似山寨",
    "candidate": "待确认",
    "not_ca": "非CA",
}
PROV_LABEL = {"wallet_factory": "监控钱包创建", "official_x": "官推确认", "both": "监控钱包创建+官推确认"}

WALLET_ORIGINS = {"wallet_trace", "wallet_trace_events"}
NAME_REASON_PREFIX = ("name", "symbol", "name_fuzzy", "token:")
HARD_EVIDENCE_MIN = 2
# site/js origins that can count as semantic CA evidence when source looks like a key
SITE_ORIGINS = {"site_scan", "js_scan", "html_scan", "config_scan", "listing_scan", "js_factory_scan"}
SEMANTIC_KEYS = ("token", "tokenaddress", "contract", "ca", "mint", "nftcontract", "collection",
                 "erc20", "token_address", "contractaddress", "contract_address")


def _src_is_official_x(s: dict, handle: str | None) -> bool:
    src = str(s.get("source") or "").lower()
    h = (handle or "").lstrip("@").lower()
    if src.startswith("x:@") or src == "x_post":
        return True
    if h and f"x.com/{h}/status/" in src:
        return True
    return False


def _norm_addr(a: str | None) -> str | None:
    if not a:
        return None
    a = str(a).strip()
    return a.lower() if a.lower().startswith("0x") else a


def _wallet_tier(addr: str | None, wallet_meta: dict | None, watched_wallets: set[str]) -> str | None:
    """Return 'high'|'medium'|'low'|None for a deployer address.
    TapeOut legacy watched_wallets set (no meta) is treated as high."""
    a = _norm_addr(addr)
    if not a:
        return None
    meta = (wallet_meta or {}).get(a)
    if meta:
        c = str(meta.get("confidence") or "low").lower()
        return c if c in ("high", "medium", "low") else "low"
    if a in (watched_wallets or set()):
        return "high"
    return None


def _via_factory_or_creation(find: dict) -> bool:
    for s in find.get("sources") or []:
        via = str(s.get("via") or s.get("reason") or s.get("source") or "").lower()
        if via.startswith("factory:") or "contract_creation" in via or via in (
            "wallet:create", "factory_create", "create",
        ):
            return True
        if s.get("origin") in ("onchain_lock", "solana_lock", "tapeout_watch", "wallet_trace",
                               "wallet_trace_events") and (
            "factory" in via or "creation" in via or s.get("factory_id") or s.get("creator_watched")
        ):
            return True
    return False


def _site_semantic(find: dict) -> bool:
    for s in find.get("sources") or []:
        o = s.get("origin") or ""
        if o not in SITE_ORIGINS and o not in ("site", "js", "html", "config", "inline"):
            # also accept origin-less site scrapes recorded as source containing key=
            src = str(s.get("source") or "").lower()
            if any(k in src for k in SEMANTIC_KEYS) and ("site" in src or "js" in src or "config" in src):
                return True
            continue
        src = str(s.get("source") or "").lower()
        key = str(s.get("key") or s.get("field") or "").lower()
        if any(k in key or k in src for k in SEMANTIC_KEYS):
            return True
        # conservative: a site/js origin that carried a verified token address counts
        if o in SITE_ORIGINS or o in ("site", "js", "html", "config", "inline"):
            return True
    return False


def collect_hard_evidence(find: dict, prov: dict, *, wallet_meta: dict | None = None,
                          watched_wallets: set[str] | None = None) -> list[dict]:
    """Independent hard evidences for pre-launch confirm (spec 4.9 / P1).
    Name/symbol match is intentionally NOT included."""
    ev: list[dict] = []
    seen: set[str] = set()

    def add(kind: str, note_zh: str, **extra):
        if kind in seen:
            return
        seen.add(kind)
        row = {"kind": kind, "note_zh": note_zh}
        row.update(extra)
        ev.append(row)

    if prov.get("official_x"):
        add("official_x", "官推直接贴出该 CA", url=prov.get("x_url"))

    tier = _wallet_tier(prov.get("creator"), wallet_meta, watched_wallets or set())
    if tier == "high":
        add("high_watched_deployer",
            f"部署者 {(prov.get('creator') or '')[:10]}… 为高可信监控钱包",
            creator=prov.get("creator"),
            watch_source=((wallet_meta or {}).get(_norm_addr(prov.get("creator")) or "") or {}).get("source"))
        if _via_factory_or_creation(find):
            add("launchpad_factory", "高可信监控钱包经工厂/合约创建事件部署")

    if _site_semantic(find):
        add("site_semantic_ca", "官网/JS/配置语义键含该 CA")

    # official-linked contract metadata (TapeOut official registry / paired)
    for s in find.get("sources") or []:
        if s.get("origin") in ("tapeout_official",) or s.get("official_x") and s.get("wallet_factory"):
            add("official_metadata", "官方登记/官链元数据列出该 CA")
            break

    return ev


def provenance(find: dict, *, official_x: dict, watched_wallets: set[str],
               wallet_meta: dict | None = None) -> dict:
    """Return provenance flags. P1: wallet_factory only when deployer is actually watched
    at high tier (or TapeOut legacy set / explicit creator_watched / wallet_trace).
    Reason strings containing 'wallet' alone do NOT set wallet_factory."""
    a = (find.get("address") or "").lower()
    handle = find.get("handle")
    wf = xo = False
    name_hit = False
    soft_wallet = False
    x_url = None
    creator = _norm_addr(find.get("traced_from"))
    wallet_meta = wallet_meta or {}

    for s in find.get("sources") or []:
        o = s.get("origin")
        src = str(s.get("source") or "")
        if o == "tapeout_watch":
            if s.get("creator_watched") or src.endswith(":creator_watched") or src == "wallet:create":
                wf = True
            if src.startswith("x:"):
                xo = True
                x_url = x_url or s.get("post_url")
            if src.endswith(":name_match"):
                name_hit = True
        elif o in WALLET_ORIGINS:
            # wallet_trace origins imply a watched wallet by construction
            wf = True
            if not creator:
                creator = _norm_addr(s.get("wallet") or s.get("traced_from") or find.get("traced_from"))
        elif o in ("onchain_lock", "solana_lock"):
            reason = str(s.get("reason") or "")
            # name/symbol signal (assist only)
            if reason.startswith(NAME_REASON_PREFIX) or "name" in reason or "symbol" in reason:
                name_hit = True
            # do NOT set wf from reason substring "wallet" — look up deployer tier below
        elif o in ("tapeout_official", "tapeout_superseded"):
            if s.get("official_x"):
                xo = True
                x_url = x_url or s.get("post_url")
            if s.get("wallet_factory"):
                wf = True
        if _src_is_official_x(s, handle):
            xo = True
            x_url = x_url or s.get("post_url")
    if a in official_x:
        xo = True
        x_url = x_url or official_x[a].get("post_url")

    tier = _wallet_tier(creator, wallet_meta, watched_wallets)
    if tier == "high":
        wf = True
    elif tier in ("medium", "low"):
        soft_wallet = True  # candidate path only

    # If tapeout/wallet_trace already set wf but meta says medium/low for same creator, keep wf
    # only when tier is high or creator is in legacy TapeOut set / no meta (legacy = high).
    if wf and creator and tier in ("medium", "low"):
        # explicit creator_watched / wallet:create from TapeOut stays; soft site wallets don't
        has_explicit = any(
            (s.get("origin") == "tapeout_watch" and (
                s.get("creator_watched") or str(s.get("source") or "") in ("wallet:create",)
                or str(s.get("source") or "").endswith(":creator_watched")))
            or s.get("origin") in WALLET_ORIGINS
            for s in (find.get("sources") or [])
        )
        if not has_explicit:
            wf = False
            soft_wallet = True

    return {
        "wallet_factory": wf,
        "official_x": xo,
        "name_only": name_hit and not wf and not xo and not soft_wallet,
        "soft_wallet": soft_wallet,
        "wallet_confidence": tier,
        "x_url": x_url,
        "creator": creator,
    }


def assess(find: dict, *, verified_ok: bool, ca_role: str | None, prov: dict,
           superseded_by: str | None = None, launched: bool = False,
           wallet_meta: dict | None = None,
           watched_wallets: set[str] | None = None,
           conflict: bool = False) -> dict:
    """Return confidence fields. P1: pre-launch confirmed needs >=2 hard evidences;
    official_x alone still confirms (事后验证); medium/low wallet → candidate;
    conflict → never confirmed."""
    wf, xo = prov["wallet_factory"], prov["official_x"]
    tag = "both" if (wf and xo) else "wallet_factory" if wf else "official_x" if xo else None
    evidences = collect_hard_evidence(find, prov, wallet_meta=wallet_meta,
                                      watched_wallets=watched_wallets)
    hard_n = len(evidences)

    if not verified_ok:
        status = "not_ca"
    elif prov.get("name_only") and not prov.get("soft_wallet"):
        status = "suspected_copycat"
    elif superseded_by and not xo:
        status = "superseded"
    elif ca_role == "nft" and not xo:
        # P0: project NFT confirmed only via official_x
        status = "candidate"
    elif conflict:
        # two competing CAs — surface for user, never auto-confirm
        status = "candidate"
    elif xo:
        # 官推 = 事后验证通道，仍可 confirmed（不计开盘前提前量）
        status = "confirmed"
    elif hard_n >= HARD_EVIDENCE_MIN:
        status = "confirmed"
    elif wf or prov.get("soft_wallet") or hard_n == 1:
        status = "candidate"
    else:
        status = "candidate"

    out = {
        "ca_status": status,
        "ca_status_zh": STATUS_LABEL[status],
        "provenance": tag,
        "provenance_zh": PROV_LABEL.get(tag) if tag else None,
        "official_x_confirmed": bool(xo),
        "wallet_factory_confirmed": bool(wf),
        "ca_role": ca_role,
        "alert_ok": status == "confirmed" and not launched and not conflict,
        "evidence": evidences,
        "hard_evidence_count": hard_n,
        "conflict": bool(conflict),
    }
    if prov.get("wallet_confidence"):
        out["creator_watch_confidence"] = prov["wallet_confidence"]
    if prov.get("soft_wallet"):
        out["soft_wallet"] = True
    if prov.get("x_url"):
        out["official_x_url"] = prov["x_url"]
    if superseded_by and status == "superseded":
        out["superseded_by"] = superseded_by
    if conflict:
        out["conflict_note_zh"] = "同一项目出现多个有证据的 CA，已标冲突，请人工确认"
    return out


def mark_conflicts(rows: list[dict]) -> list[dict]:
    """Same (project_key, ca_role) with >=2 distinct addresses that each have hard evidence
    → mark conflict; demote non-X confirmed→candidate.

    Different ca_role values (token / nft / transistors / processor) for the same project
    are intentional (e.g. TapeOut) and do NOT conflict with each other.
    """
    from collections import defaultdict
    by_key: dict[tuple, list[dict]] = defaultdict(list)
    for f in rows:
        if f.get("ca_status") in ("not_ca", "suspected_copycat", "superseded"):
            continue
        if (f.get("hard_evidence_count") or 0) < 1 and f.get("ca_status") != "confirmed":
            continue
        pk = project_key(f.get("handle"), f.get("project"))
        if not pk:
            continue
        role = f.get("ca_role") or "token"
        by_key[(pk, role)].append(f)
    for (pk, role), group in by_key.items():
        addrs = {(f.get("address") or "").lower() for f in group if f.get("address")}
        if len(addrs) < 2:
            continue
        for f in group:
            f["conflict"] = True
            f["conflict_cas"] = sorted(addrs)
            f["conflict_role"] = role
            f["conflict_note_zh"] = f"同一项目同一角色（{role}）出现多个有证据的 CA，已标冲突，请人工确认"
            if f.get("ca_status") == "confirmed" and not f.get("official_x_confirmed"):
                f["ca_status"] = "candidate"
                f["ca_status_zh"] = STATUS_LABEL["candidate"]
                f["alert_ok"] = False
    return rows


# ---------------------------------------------------------------------------
# Project CA lock — once official X posts a verified CA, later CAs for that
# project are suppressed (audit log only). Activity / WALLET_ACTIVITY untouched.
# ---------------------------------------------------------------------------
import fcntl
import json
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

BASE = Path("/workspace/project-monitor")
LOCK_PATH = BASE / "ca_project_lock.json"
SKIP_LOG = BASE / "ca_locked_skip.jsonl"
_SH = ZoneInfo("Asia/Shanghai")

# Handles that share one lock (TapeRobot watch uses TapeOutWatch; project X is TapeRobot_bsc).
PROJECT_ALIASES: dict[str, str] = {
    "tapeoutwatch": "taperobot_bsc",
    "taperobot": "taperobot_bsc",
    "taperobot_bsc": "taperobot_bsc",
}


def project_key(handle: str | None, name: str | None = None) -> str | None:
    h = (handle or "").lstrip("@").strip().lower()
    if h in PROJECT_ALIASES:
        return PROJECT_ALIASES[h]
    if h:
        return h
    n = (name or "").strip().lower()
    if not n:
        return None
    if "taperobot" in n.replace(" ", "") or "tapeout" in n.replace(" ", ""):
        return "taperobot_bsc"
    return n.replace(" ", "_")


def _now() -> str:
    return datetime.now(_SH).isoformat(timespec="seconds")


def load_locks() -> dict:
    try:
        return json.loads(LOCK_PATH.read_text(encoding="utf-8"))
    except Exception:
        return {"updated_at": None, "projects": {}}


def _save_locks(doc: dict) -> None:
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    LOCK_PATH.touch(exist_ok=True)
    with LOCK_PATH.open("r+") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        tmp = LOCK_PATH.with_suffix(".tmp")
        doc["updated_at"] = _now()
        tmp.write_text(json.dumps(doc, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        tmp.replace(LOCK_PATH)
        fcntl.flock(lf, fcntl.LOCK_UN)


def get_lock(handle: str | None, name: str | None = None) -> dict | None:
    """Return the lock entry for this project, or None."""
    key = project_key(handle, name)
    if not key:
        return None
    return (load_locks().get("projects") or {}).get(key)


def is_project_locked(handle: str | None, name: str | None = None) -> bool:
    return get_lock(handle, name) is not None


def locked_cas(handle: str | None, name: str | None = None) -> set[str]:
    lock = get_lock(handle, name) or {}
    return {(c.get("address") or "").lower() for c in (lock.get("locked_cas") or []) if c.get("address")}


def is_from_official_x(source: str | None, *, handle: str | None = None, post_url: str | None = None) -> bool:
    """True when the CA came from the project's own X account (not a third-party scrape of x.com)."""
    s = (source or "").strip()
    sl = s.lower()
    if sl.startswith("x:@"):
        return True
    if sl == "x_post":
        return True
    if post_url and handle:
        h = handle.lstrip("@").lower()
        if f"x.com/{h}/status/" in post_url.lower() or f"twitter.com/{h}/status/" in post_url.lower():
            return True
    if handle and ("x.com/" in sl or "twitter.com/" in sl):
        h = handle.lstrip("@").lower()
        if f"x.com/{h}/" in sl or f"twitter.com/{h}/" in sl:
            return True
    return False


def should_skip_ca(*, handle: str | None, name: str | None = None, address: str | None,
                   source: str | None = None, from_official_x: bool | None = None,
                   post_url: str | None = None) -> tuple[bool, str | None]:
    """After a project is locked, skip any later CA that did not come from official X
    and is not already in locked_cas[]. Returns (skip, reason)."""
    lock = get_lock(handle, name)
    if not lock:
        return False, None
    a = (address or "").strip().lower()
    if a and a in {(c.get("address") or "").lower() for c in (lock.get("locked_cas") or [])}:
        return False, None  # already the locked CA — allow rebuild / re-confirm
    ox = from_official_x if from_official_x is not None else is_from_official_x(source, handle=handle, post_url=post_url)
    if ox:
        return False, None  # exception: official X may attach another address by ca_role
    return True, (f"project locked at {lock.get('locked_at')}; "
                  f"locked_cas={[c.get('address') for c in (lock.get('locked_cas') or [])]}; "
                  f"source={source or '?'}")


def log_locked_skip(*, handle: str | None, name: str | None = None, address: str | None,
                    source: str | None = None, reason: str | None = None,
                    extra: dict | None = None) -> None:
    key = project_key(handle, name)
    lock = get_lock(handle, name) or {}
    ev = {
        "type": "CA_LOCKED_SKIP",
        "at": _now(),
        "project_key": key,
        "handle": handle,
        "name": name,
        "address": address,
        "source": source,
        "reason": reason or "project_ca_locked",
        "locked_at": lock.get("locked_at"),
        "locked_by_official_x_url": lock.get("locked_by_official_x_url"),
        **(extra or {}),
    }
    with SKIP_LOG.open("a", encoding="utf-8") as f:
        f.write(json.dumps(ev, ensure_ascii=False) + "\n")
    print(f"[ca_lock] SKIP {key} {address} via {source}: {ev['reason']}", flush=True)


def record_lock(*, handle: str | None, name: str | None = None, address: str,
                ca_role: str | None = None, post_url: str | None = None,
                verified: dict | None = None, aliases: list[str] | None = None,
                note: str | None = None) -> dict:
    """Create or update a project lock when official X posts a verified CA.
    Adds address into locked_cas[] (by ca_role). Returns the lock entry."""
    key = project_key(handle, name)
    if not key:
        raise ValueError("record_lock needs handle or name")
    a = address.strip()
    a_l = a.lower()
    LOCK_PATH.touch(exist_ok=True)
    with LOCK_PATH.open("r+") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        try:
            doc = json.loads(LOCK_PATH.read_text(encoding="utf-8"))
        except Exception:
            doc = {"projects": {}}
        projects = doc.setdefault("projects", {})
        entry = projects.get(key) or {
            "project_key": key,
            "handle": (handle or "").lstrip("@") or None,
            "name": name,
            "aliases": [],
            "locked_at": _now(),
            "locked_by_official_x_url": post_url,
            "locked_cas": [],
            "note": note,
        }
        # aliases
        alias_set = {x.lower().lstrip("@") for x in (entry.get("aliases") or []) if x}
        if handle:
            alias_set.add(handle.lstrip("@").lower())
        for x in aliases or []:
            alias_set.add(x.lstrip("@").lower())
        # keep PROJECT_ALIASES reverse links in the entry too
        for alias, canon in PROJECT_ALIASES.items():
            if canon == key:
                alias_set.add(alias)
        entry["aliases"] = sorted(alias_set)
        if handle and not entry.get("handle"):
            entry["handle"] = handle.lstrip("@")
        if name and not entry.get("name"):
            entry["name"] = name
        if post_url and not entry.get("locked_by_official_x_url"):
            entry["locked_by_official_x_url"] = post_url
        cas = entry.setdefault("locked_cas", [])
        existing = next((c for c in cas if (c.get("address") or "").lower() == a_l), None)
        if existing:
            if ca_role and not existing.get("ca_role"):
                existing["ca_role"] = ca_role
            if post_url and not existing.get("post_url"):
                existing["post_url"] = post_url
            if verified:
                existing["verified"] = {k: verified.get(k) for k in ("kind", "symbol", "name", "note") if verified.get(k) is not None}
        else:
            row = {"address": a, "ca_role": ca_role, "post_url": post_url, "added_at": _now()}
            if verified:
                row["verified"] = {k: verified.get(k) for k in ("kind", "symbol", "name", "note") if verified.get(k) is not None}
            cas.append(row)
            if post_url:
                entry["locked_by_official_x_url"] = entry.get("locked_by_official_x_url") or post_url
        if note and not entry.get("note"):
            entry["note"] = note
        projects[key] = entry
        doc["updated_at"] = _now()
        tmp = LOCK_PATH.with_suffix(".tmp")
        tmp.write_text(json.dumps(doc, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        tmp.replace(LOCK_PATH)
        fcntl.flock(lf, fcntl.LOCK_UN)
    # keep live alias map in sync for this process
    for alias in entry.get("aliases") or []:
        PROJECT_ALIASES[alias] = key
    return entry


def lock_fields(handle: str | None, name: str | None = None) -> dict:
    """Fields to merge into a ca_finds row for a locked project."""
    lock = get_lock(handle, name)
    if not lock:
        return {"ca_locked": False}
    return {
        "ca_locked": True,
        "ca_locked_at": lock.get("locked_at"),
        "locked_by_official_x_url": lock.get("locked_by_official_x_url"),
        "locked_cas": [c.get("address") for c in (lock.get("locked_cas") or [])],
        "project_key": lock.get("project_key"),
    }
