def _norm(a: str | None) -> str | None:
    if not a:
        return None
    a = str(a).strip().lower()
    return a if re.fullmatch(r"0x[0-9a-f]{40}", a) else None


def _iso(ts: int | float | str | None) -> str | None:
    if ts is None or ts == "":
        return None
    try:
        if isinstance(ts, str) and "T" in ts:
            return ts
        return datetime.fromtimestamp(int(ts), SH).isoformat(timespec="seconds")
    except Exception:
        return None


def _parse_ts(iso_or_ts) -> int | None:
    if iso_or_ts is None:
        return None
    try:
        if isinstance(iso_or_ts, (int, float)):
            return int(iso_or_ts)
        s = str(iso_or_ts).strip()
        if s.isdigit():
            return int(s)
        dt = datetime.fromisoformat(s.replace("Z", "+00:00"))
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=SH)
        return int(dt.timestamp())
    except Exception:
        return None


def load_public_funders(path: Path | None = None) -> dict[str, dict]:
    """address_norm -> {kind, label, source, chain} (chain-agnostic index; same EOA across EVM)."""
    p = path or PUBLIC_FUNDERS
    try:
        doc = json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return {}
    out: dict[str, dict] = {}
    for f in doc.get("funders") or []:
        a = _norm(f.get("address"))
        if not a or f.get("kind") == "stablecoin":
            continue
        out[a] = {
            "kind": f.get("kind") or "exchange",
            "label": f.get("label") or "",
            "source": f.get("source") or "",
            "chain": f.get("chain"),
        }
    return out


def is_public_funder(addr: str | None, public: dict[str, dict] | None = None) -> dict | None:
    a = _norm(addr)
    if not a:
        return None
    pub = public if public is not None else load_public_funders()
    return pub.get(a)


def _curl_json(url: str, timeout: int = 18) -> dict | list | None:
    cmd = ["curl", "-sS", "--max-time", str(timeout), "-A", UA, "-H", "accept: application/json", url]
    try:
        out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL)
        if not out or out.lstrip().startswith("<!"):
            return None
        return json.loads(out)
    except Exception:
        return None


V2_STATUS_FILE = BASE / "funding_hist_status.json"  # no secrets; per-chain probe results
_V2_LAST_CALL = [0.0]
_V2_MIN_INTERVAL = 0.4  # free tier 3 calls/s


def _load_v2_status() -> dict:
    try:
        return json.loads(V2_STATUS_FILE.read_text(encoding="utf-8")).get("chains") or {}
    except Exception:
        return {}


def _save_v2_status(chain: str, status: str, message: str = "") -> None:
    """Persist per-chain Etherscan V2 status (works / paid_required / key_invalid). No key."""
    try:
        doc = {}
        if V2_STATUS_FILE.exists():
            doc = json.loads(V2_STATUS_FILE.read_text(encoding="utf-8"))
        chains = doc.setdefault("chains", {})
        prev = chains.get(chain) or {}
        if prev.get("status") == status and prev.get("message") == message:
            return
        chains[chain] = {"status": status, "message": message[:200],
                         "checked_at": datetime.now(SH).isoformat(timespec="seconds")}
        doc["updated_at"] = datetime.now(SH).isoformat(timespec="seconds")
        tmp = V2_STATUS_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(doc, ensure_ascii=False, indent=2), encoding="utf-8")
        tmp.replace(V2_STATUS_FILE)
    except Exception:
        pass


def v2_chain_status(chain: str) -> str | None:
    return (_load_v2_status().get(chain) or {}).get("status")


def _etherscan_api_key() -> str | None:
    """Read key from env or local file. Never log the value."""
    for name in ETHERSCAN_KEY_ENVS:
        v = (os.environ.get(name) or "").strip()
        if v:
            return v
    for p in (BASE / ".etherscan_api_key", STAGING / ".etherscan_api_key",
              Path.home() / ".etherscan_api_key"):
        try:
            if p.is_file():
                v = p.read_text(encoding="utf-8").strip().splitlines()[0].strip()
                if v and not v.startswith("#"):
                    return v
        except Exception:
            continue
    return None


def etherscan_key_env_names_set() -> list[str]:
