# Copy to scripts/telegram/.env and fill in locally.
# Never commit .env or a Telethon *.session file.

# From https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# Group/channel peer: numeric id (e.g. -100…) or @username
TG_PEER=

# Optional. Defaults to scripts/telegram/.data/tg.session
# TG_SESSION=
# TG_DATA_DIR=
# TG_ENV_FILE=
# TG_TARGET_FILE=

# Optional proxy
# TG_PROXY_TYPE=http
# TG_PROXY_HOST=
# TG_PROXY_PORT=
# TG_PROXY_USER=
# TG_PROXY_PASS=
